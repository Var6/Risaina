<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Requested only when the user starts a voice recording (see VoiceRecorder). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Lets the user allow SOS alerts through Do Not Disturb (they grant it in system settings). -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Lets an SOS open full-screen on a locked phone where the system allows it. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Safety: the SOS alarm is a specialUse foreground service started from the high-priority FCM
         message. Google Play allows neither systemExempted nor USE_EXACT_ALARM for an app whose core
         function is not an alarm clock, so the exact-alarm permission is SCHEDULE_EXACT_ALARM, which the
         person grants in "Alarms & reminders" (the SOS readiness card links there). It lets a refused
         start retry through AlarmManager.setAlarmClock. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Safety: live location while the user shares it (started from a visible screen only, so no
         ACCESS_BACKGROUND_LOCATION is needed). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Calendar reminders are set again after a reboot (ReminderRescheduleReceiver). Already merged in
         from WorkManager; declared here so the app's own use is plain. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".RisainaApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Risaina.Splash">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Risaina.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Internal deep links used by notifications and widgets. Not exported to the web. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="risaina" android:host="app" />
            </intent-filter>
            <!-- Safety: launcher long-press shortcut "I'm in trouble" (opens the hold-to-send screen). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Safety: SOS alarm. Rings on the alarm stream until "I'm on it" or 5 minutes. -->
        <service
            android:name=".core.sos.SosAlarmService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Rings an emergency SOS alarm sent by the user's partner until the user acknowledges it" />
        </service>
        <!-- Drawn over the lock screen only while an SOS rings, like an alarm clock. It never unlocks
             the phone and never changes the lock screen or wallpaper. -->
        <activity
            android:name=".core.sos.SosAlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:taskAffinity="${applicationId}.sos"
            android:theme="@style/Theme.Risaina"
            android:turnScreenOn="true"
            tools:targetApi="27" />
        <!-- Safety: live location sharing, started only from a visible screen. -->
        <service
            android:name=".core.location.LiveLocationService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <service
            android:name=".core.notifications.RisainaMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name=".feature.widgets.PhotoWidgetReceiver"
            android:exported="true"
            android:label="Risaina photo">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_photo" />
        </receiver>

        <receiver
            android:name=".feature.widgets.LoveNoteWidgetReceiver"
            android:exported="true"
            android:label="Risaina note">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_love_note" />
        </receiver>

        <receiver
            android:name=".core.notifications.LockCardDismissedReceiver"
            android:exported="false" />

        <!-- Calendar reminders: one pending alarm for the next reminder, plain notifications only
             (never setAlarmClock, a full-screen intent or a foreground service). -->
        <receiver
            android:name=".core.reminders.ReminderAlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".core.reminders.ReminderRescheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".core.reminders.CalendarDoneReceiver"
            android:exported="false" />

        <receiver
            android:name=".feature.widgets.UsWidgetReceiver"
            android:exported="true"
            android:label="Us · all in one">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_us" />
        </receiver>

        <receiver
            android:name=".feature.widgets.TouchPingWidgetReceiver"
            android:exported="true"
            android:label="Touch Ping">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_touch_ping" />
        </receiver>

        <receiver
            android:name=".feature.widgets.EmojiWidgetReceiver"
            android:exported="true"
            android:label="Risaina emoji">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_emoji" />
        </receiver>

        <receiver
            android:name=".feature.widgets.CountdownWidgetReceiver"
            android:exported="true"
            android:label="Risaina countdown">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_countdown" />
        </receiver>

        <receiver
            android:name=".feature.widgets.VoiceNoteWidgetReceiver"
            android:exported="true"
            android:label="Risaina voice note">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_voice_note" />
        </receiver>

        <receiver
            android:name=".feature.widgets.GiftWidgetReceiver"
            android:exported="true"
            android:label="Risaina gift">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_gift" />
        </receiver>

        <!-- WorkManager: disable the automatic initializer so Hilt can provide the worker factory. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

    <!-- Delivery health: Google Play services (push) and the phone makers' auto-launch / background
         screens, which must be visible to this app (Android 11+) to be opened. -->
    <queries>
        <package android:name="com.google.android.gms" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oppo.safe" />
        <package android:name="com.oplus.battery" />
        <package android:name="com.coloros.oppoguardelf" />
        <package android:name="com.oneplus.security" />
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.miui.powerkeeper" />
        <package android:name="com.iqoo.secure" />
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.huawei.systemmanager" />
        <package android:name="com.samsung.android.lool" />
    </queries>
</manifest>
