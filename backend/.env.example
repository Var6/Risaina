# ---- Required -------------------------------------------------------------
NODE_ENV=development                 # development | test | production
HOST=0.0.0.0
PORT=8080
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=risaina_dev
# >= 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-random-string-of-at-least-32-characters
# Comma separated list of allowed browser origins. The Android app is not a browser; this mainly
# gates /docs. Use "*" only in development.
CORS_ORIGINS=http://localhost:8080
# Public URL clients can reach this server at (used for local-storage signed URLs and reset links).
PUBLIC_BASE_URL=http://localhost:8080
LOG_LEVEL=info

# ---- Storage --------------------------------------------------------------
# local = development-only driver that stores files under LOCAL_STORAGE_DIR and serves
#         HMAC-signed, expiring URLs from this server. Refused when NODE_ENV=production.
# r2    = Cloudflare R2 (S3 API) private bucket; requires all R2_* values below.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/storage
#R2_ACCOUNT_ID=
#R2_ACCESS_KEY_ID=
#R2_SECRET_ACCESS_KEY=
#R2_BUCKET=risaina-media
#R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# ---- Push (FCM) -----------------------------------------------------------
# Leave unset to run with push DISABLED (reported in /health). Accepts either a path to the
# Firebase service-account JSON file or the base64-encoded JSON itself.
#FIREBASE_SERVICE_ACCOUNT_JSON=./firebase-service-account.json

# ---- Mailer ---------------------------------------------------------------
# Only "console" exists today (logs a non-sensitive line; prints the reset link in development).
MAILER=console

# ---- Limits (defaults shown; all optional) --------------------------------
#ACCESS_TOKEN_TTL_SECONDS=900
#REFRESH_TOKEN_TTL_DAYS=30
#PASSWORD_RESET_TTL_MINUTES=30
#INVITATION_TTL_HOURS=24
#INVITATION_ACCEPT_MAX_ATTEMPTS=5
#INVITATION_ACCEPT_WINDOW_MINUTES=15
#PING_COOLDOWN_SECONDS=15
#PINGS_PER_HOUR=40
#MEDIA_MAX_PHOTO_BYTES=10485760
#MEDIA_MAX_VOICE_BYTES=8388608
#MEDIA_MAX_VOICE_DURATION_MS=180000
#MEDIA_MAX_AVATAR_BYTES=3145728
#MEDIA_MAX_WALLPAPER_BYTES=12582912
#MEDIA_UPLOAD_URL_TTL_SECONDS=600
#MEDIA_DOWNLOAD_URL_TTL_SECONDS=900
#MEDIA_ABANDONED_UPLOAD_HOURS=24
#RATE_LIMIT_GLOBAL_MAX=300
#RATE_LIMIT_GLOBAL_WINDOW_MS=60000
#RATE_LIMIT_AUTH_MAX=10
#RATE_LIMIT_AUTH_WINDOW_MS=900000
#OUTBOX_POLL_MS=1000
#OUTBOX_LEASE_MS=30000
#OUTBOX_MAX_ATTEMPTS=5
#OUTBOX_BACKOFF_BASE_MS=2000
#CLEANUP_INTERVAL_MS=900000
#WS_AUTH_TIMEOUT_MS=5000
#WS_PING_INTERVAL_MS=30000
#WS_IDLE_TIMEOUT_MS=90000
#WS_MAX_PENDING_SENDS=500
